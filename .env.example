# Variables de entorno de referencia (sin secretos).
# Copiar a `.env` y completar los valores reales.

API_URI_PREFIX=/api
PORT=4000

# Auth
JWT_SECRET=
TOKEN_LIFETIME=12

# Base de datos
MONGODB_URI=mongodb://localhost/recetar

# ANDES / MPI
ANDES_ENDPOINT=
ANDES_MPI_ENDPOINT=
JWT_MPI_TOKEN=

# Vademecum MS
VADEMECUM_MS_URL=http://localhost:4001
VADEMECUM_API_KEY=

# Praxis (prescripción electrónica)
# PRAXYS_ENDPOINT es el host base (el cliente agrega `api/...`). No incluir `/api`.
PRAXYS_ENDPOINT=
PRAXYS_API_KEY=
# Tipo y provincia de la matrícula por defecto (N=Nacional, P=Provincial; Q=Neuquén)
PRAXYS_MATRICULA_TIPO=P
PRAXYS_MATRICULA_PROVINCIA=Q

# Validación de pacientes
PATIENT_VALIDATION_ENABLED=true

# SISA (organizaciones)
SISA_URL=
SISA_USERNAME=
SISA_PASSWORD=
SISA_PROVINCIA=15

# Email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USERNAME=
EMAIL_PASSWORD=
TEMPLATES_PATH=./src/templates
CF_SECRET_KEY=

# Jobs / Agenda
JOBS_PORT=3000
AGENDA_UI_PORT=3001
